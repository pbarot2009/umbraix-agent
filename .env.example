# Umbraix Agent v0.2 — copy to `.env` and fill in values. Never commit `.env`.

# ---------- Required ----------
DISCORD_TOKEN=your_discord_bot_token
# Operator (bot owner) key: used only for OWNER_ID's requests.
GEMINI_API_KEY=your_gemini_api_key
OWNER_ID=123456789012345678
# Encrypts stored BYOK keys (AES-256-GCM). Generate: openssl rand -base64 32
# BACK IT UP: losing it makes every stored key unreadable.
MASTER_KEY=

# ---------- Storage ----------
DATABASE_URL=sqlite://data/umbraix.db

# ---------- Commands ----------
COMMAND_PREFIX=!
# Name of the role auto-created by !byok-server.
ALLOW_AGENT_ROLE_NAME=allow_agent
# How long a DM key-collection session stays open (60-1800s).
BYOK_SESSION_SECS=300
REGISTER_SLASH_COMMANDS=true
# Register slash commands to one guild only (instant updates while developing).
# DEV_GUILD_ID=123456789012345678

# ---------- Agent ----------
GEMINI_MODEL=gemini-flash-lite-latest
# ReAct tool-step budget per request (1-256). Big server builds need 50+;
# 25 handles most multi-step moderation + channel/role work.
MAX_ITERATIONS=25
AGENT_TEMPERATURE=0.2
# Retained conversation entries per (channel, user).
HISTORY_LIMIT=20
# Default per-user cooldown (servers can override with !config cooldown).
RATE_LIMIT_SECS=3
# Whole-turn wall clock (30-1800s). Large 256-step builds need headroom.
TURN_TIMEOUT_SECS=600
MAX_TOOL_OUTPUT_CHARS=4000

# ---------- Throughput & resilience ----------
# Agent turns running at once across all servers; extra requests queue.
MAX_CONCURRENT_TURNS=128
# Concurrent Gemini calls per API key (Gemini limits are per Google project).
MAX_CONCURRENT_PER_KEY=8
# How long a queued request waits for a slot before giving up.
QUEUE_TIMEOUT_SECS=60
# Retries for transient Gemini errors (429 per-minute, 408, 5xx, network).
GEMINI_MAX_RETRIES=4
GEMINI_REQUEST_TIMEOUT_SECS=60

# ---------- Logging & reporting ----------
RUST_LOG=info,sqlx=warn
# pretty | json
LOG_FORMAT=pretty
# When set, also write daily-rotated JSON logs to this directory.
# LOG_DIR=logs
# Channel that receives internal error reports (with reference IDs).
# ERROR_LOG_CHANNEL_ID=123456789012345678
