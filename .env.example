# Copy to `.env` and fill in values. Never commit `.env`.
DISCORD_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key
OWNER_ID=123456789012345678

# Optional (defaults shown)
GEMINI_MODEL=gemini-flash-lite-latest
# Real-world bulk jobs need 30-60 steps; cap is now 100 (was 25).
# Loop detection + TURN_TIMEOUT_SECS are the safety rails, not a low cap.
MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.2
HISTORY_LIMIT=20
RATE_LIMIT_SECS=3
# Whole-turn timeout: abort a stuck multi-step run after N seconds (30-1800).
TURN_TIMEOUT_SECS=300
# Truncate any single tool output to N chars so huge listings can't blow context.
MAX_TOOL_OUTPUT_CHARS=4000
RUST_LOG=info
